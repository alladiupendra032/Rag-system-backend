# Copy these to Vercel Dashboard → Project → Settings → Environment Variables
# NEVER commit real values — this file is for reference only

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag
PINECONE_INDEX_DIMENSION=1024
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=llama-text-embed-v2

GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

RATE_LIMIT_PER_MINUTE=40

# Set this to your production frontend URL (e.g. https://your-shop.vercel.app)
# Use * during development only
CORS_ALLOW_ORIGINS=*
